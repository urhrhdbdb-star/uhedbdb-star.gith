    local function computePath(from, to)
        for _, r in ipairs({ 6, 4, 2.5 }) do
            local path = PFS:CreatePath({ AgentRadius = r, AgentHeight = 6, AgentCanJump = false, WaypointSpacing = 12 })
            local ok = pcall(function() path:ComputeAsync(from, to) end)
            if ok and path.Status == Enum.PathStatus.Success then
                local pts = {}
                for _, w in ipairs(path:GetWaypoints()) do pts[#pts+1] = w.Position end
                if #pts > 1 then return pts, true end
            end
        end
        return { to }, false
    end

    -- car + driver collisions (off while driving underground)
    local savedCC = {}
    local function carCollide(car, on)
        if on then
            for p, v in pairs(savedCC) do if p.Parent then p.CanCollide = v end end
            savedCC = {}
        else
            local list = car:GetDescendants()
            if L.Character then for _, d in ipairs(L.Character:GetDescendants()) do list[#list+1] = d end end
            for _, p in ipairs(list) do
                if p:IsA("BasePart") and p.CanCollide then savedCC[p] = true; p.CanCollide = false end
