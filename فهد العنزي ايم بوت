    -- spawn (if needed) -> get in -> drive to target.  Calls onFinish(ok, msg) when done.
    -- stand completely still (no drifting / falling) until the returned function is called
    function Travel.holdStill()
        local hrp = L.Character and L.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return function() end end
        local cf = hrp.CFrame
        local c = R.Heartbeat:Connect(function()
            if not hrp.Parent then return end
            hrp.CFrame = cf
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        return function() if c then c:Disconnect(); c = nil end end
    end
    Travel.badCar = nil      -- a car we couldn't bring up / get into -> replaced next trip
    function Travel.trip(target, label, notifyFn, hopOut, onFinish, opts)
        notifyFn = notifyFn or function() end
        if busy then if onFinish then onFinish(false, "Already driving") end return end
        busy = true
        task.spawn(function()
            local result, rmsg = false, ""
            Travel._cancelWait = false
            Travel._died = false
            local tripChar = L.Character
            Travel.noclipOn()
            local okAll, err = pcall(function()
                local car = Travel.myCar()
                -- last time this car was stuck under the map / couldn't be entered -> get a fresh one
                if car and Travel.badCar == car and (Travel.badCount or 0) >= 2 and not seatedIn(car) then   -- only after 2 failed tries
                    notifyFn("Travel", "Your old car is stuck â replacing itâ¦", "car")
                    pcall(Travel.despawn)
                    task.wait(0.5)
                    car = Travel.myCar()
                end
                if Travel.badCar ~= car then Travel.badCar = nil end
                local seatedAlready = car and seatedIn(car)
                -- stand still (inside the safe zone if we came from one) until the car timer is over
                local safeSpot = nil
                local function waitTimerStill(why)
                    local left = Travel.timerLeft()
                    if left <= 0 or Travel.myCar() then return end
                    -- came out of a safe zone this trip -> step back in and wait there
                    if safeSpot and not Travel.inSafeZone() and Travel.glide then
                        pcall(Travel.glide, safeSpot, function() return not Travel._cancelWait end)
                    end
                    local release = Travel.holdStill()
                    local untilT = os.clock() + left + 0.3
                    local lastShown = -1
                    local okW, errW = pcall(function()
                        while os.clock() < untilT do
                            if Travel._cancelWait then error("you pressed Stop") end
                            if L.Character ~= tripChar then error("you died") end
                            if Travel.myCar() then break end
                            local l = math.ceil(untilT - os.clock())
                            if l ~= lastShown and (l % 10 == 0 or l <= 3 or lastShown < 0) then
                                lastShown = l
