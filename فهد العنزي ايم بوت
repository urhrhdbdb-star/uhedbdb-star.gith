                if not seatedAlready and Travel.inSafeZone() then
                    local hrpS = L.Character and L.Character:FindFirstChild("HumanoidRootPart")
                    safeSpot = hrpS and hrpS.Position
                    -- no car out + car on its timer -> wait IN the safe zone (don't stand in the road)
                    if not car and Travel.timerLeft() > 0 then waitTimerStill("waiting in the safe zone") end
                    -- your car is parked nearby (outside the zone) -> walk straight out to it, stand at the door
                    if car and car.Parent and hrpS and (car:GetPivot().Position - hrpS.Position).Magnitude < 350 then
