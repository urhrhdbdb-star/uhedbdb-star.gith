    local function driveTo(car, target, onDone, opt)
        finish(false, "new trip")
        local ok0, cf0 = pcall(car.GetPivot, car)
        if not ok0 then return onDone(false, "Car has no position") end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local ignore = { car, L.Character }
        for _, p in ipairs(P:GetPlayers()) do if p.Character then ignore[#ignore+1] = p.Character end end
        rp.FilterDescendantsInstances = ignore
        pcall(function() rp.RespectCanCollide = true end)   -- invisible zone parts don't count as walls

        -- ground right under a point, searching down from a bit above it (so roofs/bridges above don't count)
        local function groundY(pos, above)
            local hit = workspace:Raycast(pos + Vector3.new(0, above or 6, 0), Vector3.new(0, -80, 0), rp)
            return hit and hit.Position.Y or nil
        end
        -- natural ground (grass / sand cliffs = Terrain) a bit ahead, looking down from higher up
        local function terrainAhead(pos, dir)
            local best
            for _, d in ipairs({ 4, 8, 12 }) do
                local hit = workspace:Raycast(pos + dir * d + Vector3.new(0, 30, 0), Vector3.new(0, -60, 0), rp)
                if hit and hit.Instance == workspace.Terrain and (not best or hit.Position.Y > best) then best = hit.Position.Y end
            end
            return best
        end
        local g0 = groundY(cf0.Position, 4)
        local hover = g0 and math.clamp(cf0.Position.Y - g0, 1, 8) or 3
        local size = Vector3.new(6, 4, 12)
        pcall(function() size = car:GetExtentsSize() end)
        local halfW = math.clamp(size.X, 4, 12) / 2

        local under = S.DriveMode == "Under" and not (opt and opt.above)
        local pts, onRoad = { target }, true
        if not under and not (opt and opt.direct) then
            local rr = Travel.roadRoute and Travel.roadRoute(cf0.Position, target)   -- YOUR recorded streets first
            if rr then pts, onRoad = rr, true else pts, onRoad = computePath(cf0.Position, target) end
        end

        local tGround = groundY(target, 8) or target.Y
        local underY = math.min(g0 or cf0.Position.Y, tGround) - math.max(S.UnderDepth, 10)
        if under then
            carCollide(car, false)
            cf0 = CFrame.new(cf0.Position.X, underY, cf0.Position.Z) * cf0.Rotation
            pcall(function() car:PivotTo(cf0) end)
        end

        local ghostUntil = 0                                 -- > now = driving straight THROUGH walls
        pendingDone = function(ok, msg)
            if ghostUntil > 0 then ghostUntil = 0; pcall(carCollide, car, true) end
            if under then
                -- come back up at the destination
                pcall(function()
                    local cur = car:GetPivot()
                    local gy = groundY(Vector3.new(cur.Position.X, tGround, cur.Position.Z), 8) or tGround
                    car:PivotTo(CFrame.new(cur.Position.X, gy + hover + 0.5, cur.Position.Z) * cur.Rotation)
                end)
                task.wait(0.1)
                carCollide(car, true)
            end
            onDone(ok, msg)
        end
        Travel.driving = true
        Travel.camDrive(true)
        local i = 1
        local curCF = cf0
        local stuckT, lastPos, stuckCount, climbUntil = 0, cf0.Position, 0, 0
        local lastSide = 1
        local hopUntil = 0
        local HOP_MAX = 11                                   -- fences / barriers lower than this get hopped
        local carLen = math.clamp(size.Z, 8, 24)
        local bestDist, bestT = (cf0.Position - target).Magnitude, os.clock()
        local boxedT = 0
        local climbTop, climbUntil = nil, 0                  -- going OVER a wall: its top height
        local chkT, chkPos = os.clock(), cf0.Position
        local maxY = math.max(cf0.Position.Y, (groundY(target, 8) or target.Y) + hover) + 10
        local function ghost(secs)
            if os.clock() >= ghostUntil then carCollide(car, false) end
            ghostUntil = os.clock() + secs
            boxedT, bestT, chkT, chkPos = 0, os.clock(), os.clock(), curCF.Position
        end
        -- blocked low but open higher up = a fence / barrier -> hop it
        local function lowObstacle(pos, dir, len)
            local right = Vector3.new(-dir.Z, 0, dir.X)
            local blocked = false
            for _, off in ipairs({ 0, halfW, -halfW }) do
                local hit = workspace:Raycast(pos + right * off + Vector3.new(0, 1.2, 0), dir * len, rp)
                if hit and hit.Normal.Y < 0.55 and hit.Instance ~= workspace.Terrain then blocked = true; break end
            end
            if not blocked then return false end
            for _, off in ipairs({ 0, halfW, -halfW }) do
                if workspace:Raycast(pos + right * off + Vector3.new(0, HOP_MAX, 0), dir * (len + 6), rp) then return false end
            end
            return true
        end

        -- is the way ahead clear? (3 parallel rays: center + both sides of the car, 2 heights)
        local function clear(pos, dir, len)
            local right = Vector3.new(-dir.Z, 0, dir.X)
            for _, h in ipairs({ 1.2, 3.5 }) do
                for _, off in ipairs({ 0, halfW, -halfW }) do
                    local o = pos + right * off + Vector3.new(0, h, 0)
                    local hit = workspace:Raycast(o, dir * len, rp)
                    if hit and hit.Normal.Y < 0.55 and hit.Instance ~= workspace.Terrain then return false end   -- a wall, not a ramp / hill
                end
            end
            return true
        end
        local function rot(v, deg)
            local r = math.rad(deg)
            local c, s = math.cos(r), math.sin(r)
            return Vector3.new(v.X * c - v.Z * s, 0, v.X * s + v.Z * c)
        end

        local curSpd = 0
        pcall(function() local v = (car.PrimaryPart or driverSeat(car)).AssemblyLinearVelocity; curSpd = Vector3.new(v.X, 0, v.Z).Magnitude end)
        local carSpeed = Travel.safeSpeed(car)                -- 10 mph under YOUR car's top speed
        driveConn = RunS.Heartbeat:Connect(function(dt)
            if not Travel.driving or not car.Parent or not seatedIn(car) then
                return finish(false, not car.Parent and "Car was removed" or "You left the car")
            end
            local pos = curCF.Position
            local wp = pts[i]
            local flat = Vector3.new(wp.X - pos.X, 0, wp.Z - pos.Z)
            local dist = flat.Magnitude
            if dist < 5 then
                i = i + 1
                if i > #pts then
                    pcall(function()
                        local pp = car.PrimaryPart or driverSeat(car)
                        if pp then pp.AssemblyLinearVelocity = Vector3.zero; pp.AssemblyAngularVelocity = Vector3.zero end
                    end)
                    return finish(true, "")
                end
                return
            end
            local want = flat.Unit
            local speed = carSpeed
            if i == #pts and dist < 45 then speed = math.max(10, speed * dist / 45) end
            local dir = want
            local y

            if under then
                y = underY
            else
                -- SAFE: never through walls, never fast up/down, never floating.
                -- wall / cliff ahead -> slow down, climb gently over it, come straight back down to the ground
                local look = math.clamp(speed * 0.6, 10, 35)
                local groundNow = pos.Y - hover
                local groundPos = Vector3.new(pos.X, groundNow, pos.Z)
                local MAX_CLIMB = 22                             -- higher than this = too high (car gets deleted) -> go around
                local RISE, SINK = 8, 9                          -- studs per second up / down (slow + smooth)
                -- highest solid top in the next `len` studs (looking down from above), and how far away it starts
                local function topAhead(d0, len)
                    local best, firstD
                    for d = d0, len, 2 do
                        local p = groundPos + dir * d
                        local hit = workspace:Raycast(Vector3.new(p.X, groundNow + MAX_CLIMB + 6, p.Z), Vector3.new(0, -(MAX_CLIMB + 14), 0), rp)
                        if hit and hit.Position.Y > groundNow + 1.5 then
                            if not best or hit.Position.Y > best then best = hit.Position.Y end
                            firstD = firstD or d
                        end
                    end
                    return best, firstD
                end
                if opt and opt.noDodge then
                    dir = want                                   -- known road (dock ramp): follow it
                elseif os.clock() < ghostUntil then
                    dir = want                                   -- already going through: keep straight
                elseif not clear(groundPos, want, look) then
                    ghost(2.5); dir = want                       -- ð§ª TEST: always straight THROUGH walls (stays level, never over)
                end
                -- climbing: keep checking the top right ahead until we're over it
                if climbTop and os.clock() < climbUntil then
                    local t2 = topAhead(0, 10)
                    if t2 and t2 - groundNow <= MAX_CLIMB then climbTop = math.max(climbTop, t2); climbUntil = os.clock() + 0.6 end
                elseif climbTop then
                    climbTop = nil
                end
                local step0 = pos + dir * math.min(speed * dt, dist)
                local gy
                if os.clock() < ghostUntil then
                    gy = groundY(step0, 3)
                    if not gy or math.abs(gy - groundNow) > 3 then gy = groundNow end
                else
                    gy = groundY(step0, 4)
                    -- a grass / sand cliff coming up -> start rising BEFORE it
                    local tA = terrainAhead(pos, dir)
                    if tA and tA - groundNow > 1.5 and (not gy or tA > gy) then gy = tA end
                    if climbTop and (not gy or climbTop > gy) then gy = climbTop end
                end
                -- crossing the beach wall -> straight across it on a smooth slope (sand height <-> top height)
                local sC = cliffS(step0)
                if math.abs(sC) < 22 and pos.Y > CLIFF_SAND_Y - 6 and pos.Y < CLIFF_TOP_Y + 9 then   -- (not the ramp up above)
                    dir = want
                    step0 = pos + dir * math.min(speed * dt, dist)
                    sC = cliffS(step0)
                    local onLine = Vector3.new(step0.X, 0, step0.Z) - CLIFF_N * sC
                    local sp, tp = onLine - CLIFF_N * 18, onLine + CLIFF_N * 6
                    local sg = groundY(Vector3.new(sp.X, 372, sp.Z), 0) or CLIFF_SAND_Y
                    local tg = groundY(Vector3.new(tp.X, 380, tp.Z), 0) or CLIFF_TOP_Y
                    if math.abs(sg - CLIFF_SAND_Y) > 12 then sg = CLIFF_SAND_Y end
                    if math.abs(tg - CLIFF_TOP_Y) > 12 then tg = CLIFF_TOP_Y end
                    local t = math.clamp((sC + 18) / 24, 0, 1)
                    gy = sg + (tg - sg) * (t * t * (3 - 2 * t))
                    speed = math.min(speed, 18)
                end
                if gy then
                    local tgtY = gy + hover
                    local dy = tgtY - pos.Y
                    if math.abs(dy) > 1.5 then
                        -- big step up / down: slow right down so the climb / drop is gentle
                        speed = math.min(speed, math.max(6, 18 - math.abs(dy)))
                    end
                    if climbTop and climbTop + hover > pos.Y + 0.5 then
                        -- not high enough yet for the wall ahead: barely creep forward while rising
                        local _, wd = topAhead(1, 8)
                        if wd and wd < 4 then speed = math.min(speed, 3) end
                    end
                    if dy > 0 then
                        y = pos.Y + math.min(dy, RISE * dt)
                    else
                        y = math.max(tgtY, pos.Y - SINK * dt)    -- back down to the ground (no floating)
                    end
                else
                    y = math.max(pos.Y - SINK * dt, groundNow + hover - 30)   -- no ground found: drift down, never hang in the air
                end
                -- hard ceiling: never higher than the ground under you + the max climb
                y = math.min(y, math.max(maxY, groundNow + MAX_CLIMB + hover))
            end

            -- smooth like a real car: speeds up / slows down gradually (no instant top speed)
            if curSpd < speed then curSpd = math.min(speed, curSpd + 26 * dt) else curSpd = math.max(speed, curSpd - 45 * dt) end
            speed = curSpd
            local np = pos + dir * math.min(speed * dt, dist)
            np = Vector3.new(np.X, y, np.Z)
            local lookCF = CFrame.lookAt(np, np + dir)
            curCF = CFrame.new(np) * curCF.Rotation:Lerp(lookCF.Rotation, math.clamp(dt * 7, 0, 1))
            pcall(function()
                car:PivotTo(curCF)
                local pp = car.PrimaryPart or driverSeat(car)
                if pp then
                    pp.AssemblyLinearVelocity = under and Vector3.zero or dir * speed   -- moving AS fast as it really moves
                    pp.AssemblyAngularVelocity = Vector3.zero
                end
            end)

            -- not getting closer / boxed in by a wall -> hop out and noclip through to the place
            if not under then
                local dNow = (Vector3.new(np.X, target.Y, np.Z) - target).Magnitude
                if dNow < bestDist - 8 then bestDist, bestT = dNow, os.clock() end
                -- stuck 3 seconds (not moving / going back and forth at a wall), or a long detour going nowhere
                if os.clock() - chkT >= 6 then
                    -- really stuck for 6s (and not busy climbing a wall) -> last resort
                    if not climbTop and (np - chkPos).Magnitude < 8 and os.clock() - bestT >= 6 then ghost(3) end
                    chkT, chkPos = os.clock(), np
                end
                if os.clock() - bestT > 25 and not climbTop then ghost(4) end   -- going nowhere for a long time
                if ghostUntil > 0 and os.clock() >= ghostUntil then
                    ghostUntil = 0
                    carCollide(car, true)                         -- out the other side -> normal again
                end
            end
            -- stuck: re-plan the road from here, then skip ahead / hop
            stuckT = stuckT + dt
            if stuckT > 2 then
                if (np - lastPos).Magnitude < 4 then
                    stuckCount = stuckCount + 1
                    if not under and stuckCount == 1 then
                        task.spawn(function()
                            local np2, ok2 = computePath(np, target)
                            if ok2 then pts, i = np2, 1 end
                        end)
                    elseif stuckCount >= 2 then
                        i = math.min(i + 1, #pts)
                        climbUntil = os.clock() + 1
                        stuckCount = 0
                    end
                else
                    stuckCount = 0
                end
                stuckT, lastPos = 0, np
            end
        end)
    end

    -- ââ main: spawn (if needed) -> get in -> drive âââââââââââââââ
    local busy = false
