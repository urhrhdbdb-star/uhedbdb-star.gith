E.safe("Repair", function()
    -- ReplicatedStorage.MotorDamage.RepairMotor (RemoteFunction) = the inventory's
    -- "REPAIR +1000 HP  â¢  $250" button. The exact args are learned the first time the
    -- game uses it; until then it tries the likely formats and keeps the one that works.
    local RS = game:GetService("ReplicatedStorage")
    local MD = RS:FindFirstChild("MotorDamage")
    local rRepair = MD and MD:FindFirstChild("RepairMotor")
    local rNotify = MD and MD:FindFirstChild("MotorNotify")
    local learned
    pcall(function() if S.RepairArgs ~= "" then learned = Http:JSONDecode(S.RepairArgs) end end)

    local function carHP(car)
        -- any health-looking number on the car (attributes or values), + its max if there is one
        local hp, mx
        local function look(inst)
            for k, v in pairs(inst:GetAttributes()) do
                local n = string.lower(k)
                if type(v) == "number" and (string.find(n, "health", 1, true) or string.find(n, "motor", 1, true) or n == "hp" or string.find(n, "engine", 1, true)) then
                    if string.find(n, "max", 1, true) then mx = mx or v else hp = hp or v end
                end
            end
            for _, c in ipairs(inst:GetChildren()) do
                if c:IsA("NumberValue") or c:IsA("IntValue") then
                    local n = string.lower(c.Name)
                    if string.find(n, "health", 1, true) or string.find(n, "motor", 1, true) or n == "hp" then
                        if string.find(n, "max", 1, true) then mx = mx or c.Value else hp = hp or c.Value end
                    end
                end
            end
        end
        pcall(look, car)
        if not hp then local ds = car:FindFirstChild("DriverSeat"); if ds then pcall(look, ds) end end
        if not hp then local b = car:FindFirstChild("Body"); if b then pcall(look, b) end end
        if not hp then local m = car:FindFirstChild("Motors"); if m then pcall(look, m) end end
        if not hp then
            pcall(function()
                for k, v in pairs(L:GetAttributes()) do
                    local n = string.lower(k)
                    if type(v) == "number" and (string.find(n, "motor", 1, true) or string.find(n, "car", 1, true) or string.find(n, "vehicle", 1, true))
                        and (string.find(n, "health", 1, true) or string.find(n, "hp", 1, true)) then
                        if string.find(n, "max", 1, true) then mx = mx or v else hp = hp or v end
                    end
                end
            end)
        end
        return hp, mx
    end
    Repair.carHP = carHP

    local rRepair2 = RS:FindFirstChild("RepairVehicle")
    local REMOTES = {}
    if rRepair and rRepair:IsA("RemoteFunction") then REMOTES[#REMOTES+1] = rRepair end
    if rRepair2 and rRepair2:IsA("RemoteFunction") then REMOTES[#REMOTES+1] = rRepair2 end
    Repair.available = #REMOTES > 0
    local function remoteByName(n) for _, r in ipairs(REMOTES) do if r.Name == n then return r end end return nil end

    -- true = repaired, false = refused, nil = no clear answer (then we check if the $ was taken)
    local function invoke(remote, args, n)
        local done, ok, res = false, false, nil
        task.spawn(function() ok, res = pcall(function() return remote:InvokeServer(table.unpack(args, 1, n)) end); done = true end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < 5 do task.wait(0.05) end
        if not done or not ok then return nil, "no answer" end
        if res == false then return false, "refused" end
        if res == true then return true, "" end
        if type(res) == "table" then
            if res.success == false or res.ok == false or res.Success == false then return false, tostring(res.message or res.msg or res.error or "refused") end
            if res.success == true or res.ok == true or res.Success == true then return true, tostring(res.message or res.msg or "") end
        end
        if type(res) == "string" then
            local low = string.lower(res)
            if string.find(low, "not", 1, true) or string.find(low, "enough", 1, true) or string.find(low, "fail", 1, true)
                or string.find(low, "full", 1, true) or string.find(low, "no ", 1, true) then return false, res end
            return true, res
        end
        return nil, ""
    end
    local busy = false
    function Repair.now(notifyFn)
        notifyFn = notifyFn or function() end
        if #REMOTES == 0 then return false, "Repair remote not found" end
        if busy then return false, "Already repairing" end
        local car = Travel.myCar and Travel.myCar()
        if not car then return false, "No car spawned" end
        busy = true
        local cname = (Travel.carModelName and Travel.carModelName(car)) or (Travel.defaultCar and Travel.defaultCar()) or ""
        local function build(spec)
            local a = {}
            for i = 1, spec.n do
                local x = spec[i]
                if x == "__CAR" then x = car elseif x == "__CARNAME" then x = cname end
                a[i] = x
            end
            return a
        end
        local list = {}
        if learned and learned.n then list[#list+1] = { r = remoteByName(learned.remote) or REMOTES[1], spec = learned } end
        for _, r in ipairs(REMOTES) do
            for _, spec in ipairs({ { n = 1, "__CARNAME" }, { n = 1, "__CAR" }, { n = 0 }, { n = 2, "__CAR", "__CARNAME" } }) do
                list[#list+1] = { r = r, spec = spec }
            end
        end
        local okAny, msg = false, ""
        for _, c in ipairs(list) do
            local cash0 = Shop.cash and Shop.cash() or 0
            local ok, m = invoke(c.r, build(c.spec), c.spec.n)
            msg = (m and m ~= "") and m or msg
            if ok == nil then task.wait(1) end
            local paid = Shop.cash and cash0 > 0 and Shop.cash() < cash0 - 1
            if ok == true or paid then
                okAny = true
                if c.spec ~= learned then
                    local save = { n = c.spec.n, remote = c.r.Name }
                    for i = 1, c.spec.n do save[i] = c.spec[i] end
                    learned = save
                    pcall(function() S.RepairArgs = Http:JSONEncode(save) end)
                end
                break
            end
            if ok == false and string.find(string.lower(m or ""), "enough", 1, true) then break end
        end
        busy = false
        return okAny, msg
    end

    -- learn the args when the game's own REPAIR button is used
    if #REMOTES > 0 and hookmetamethod and getnamecallmethod then
        E.learn(REMOTES, function(self, ...)
            if not checkcaller() and getnamecallmethod() == "InvokeServer" then
                local args, rname = table.pack(...), self.Name
                task.defer(function()
                    local car = Travel.myCar and Travel.myCar()
                    local cname = car and Travel.carModelName and Travel.carModelName(car)
                    local simple = { n = args.n, remote = rname }
                    for i = 1, args.n do
                        local x = args[i]
                        if typeof(x) == "Instance" and car and (x == car or x:IsDescendantOf(car)) then simple[i] = "__CAR"
                        elseif type(x) == "string" and cname and x == cname then simple[i] = "__CARNAME"
                        elseif type(x) == "string" or type(x) == "number" or type(x) == "boolean" then simple[i] = x end
                    end
                    learned = simple
                    pcall(function() S.RepairArgs = Http:JSONEncode(simple) end)
                end)
            end
        end)
    end

    -- auto repair: when the car is damaged (â¥1000 HP missing, or under 40%), or the game says the motor is hurt
    local lastTry = 0
    local function maybeRepair(force)
        if not S.AutoRepair or busy or os.clock() - lastTry < 8 then return end
        local car = Travel.myCar and Travel.myCar()
        if not car then return end
        local hp, mx = carHP(car)
        local need = force
        if hp then
            mx = mx or math.max(hp, 1000)
            if hp <= 0 or (mx - hp) >= 1000 or hp < mx * 0.4 then need = true end
        end
        if not need then return end
        if Shop.cash and Shop.cash() < 250 then return end
        lastTry = os.clock()
        task.spawn(function()
            local ok, msg = Repair.now()
            if Repair.onResult then pcall(Repair.onResult, ok, msg) end
        end)
    end
    if rNotify then rNotify.OnClientEvent:Connect(function() task.delay(0.5, maybeRepair, true) end) end
    task.spawn(function()
        while ALIVE() do
            task.wait(2)
            pcall(maybeRepair, false)
        end
    end)
end)
