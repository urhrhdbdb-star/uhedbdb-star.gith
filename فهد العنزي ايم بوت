                        local want = (a > 0.9 and 0.4) or (a > 0.5 and 0.65) or 1
                        local cap = (a > 0.9 and 16) or (a > 0.5 and 28) or math.huge
                        if last and dHere < 45 then
                            want = math.min(want, 0.3 + dHere / 60)
                            cap = math.min(cap, 6 + dHere * 0.55)
                        end
                        th = spd > cap and -0.5 or want
                    end
                    -- stuck on something -> back up a bit, turning the other way, then try again
                    if th > 0.2 and spd < 1.5 then
                        stuckT = stuckT or now
                        if now - stuckT > 1.6 then
                            stucks = stucks + 1
                            revUntil = now + 1.3
                            revSteer = (st ~= 0 and -st or (stucks % 2 == 0 and 1 or -1))
                            stuckT = nil
                            if stucks >= 7 then res, msg = false, "STUCK"; break end
                        end
                    else
                        stuckT = nil
                    end
                end
            end
        end
        th, st = 0, 0
        apply()
        pcall(function() RSv:UnbindFromRenderStep(bindName) end)
        stConn:Disconnect()
        for k, down in pairs(keysDown) do if down then key(k, false) end end
        pcall(function() seat.Throttle = 0; seat.Steer = 0; seat.ThrottleFloat = 0; seat.SteerFloat = 0 end)
        Travel.driving = false
        return res, msg
    end
