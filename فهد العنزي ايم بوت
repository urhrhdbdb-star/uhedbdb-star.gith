    -- ââ ð NORMAL DRIVING âââââââââââââââââââââââââââââââââââââââââââ
    -- the car drives itself like a player holding the gas: real car physics, on the streets
    -- (pathfinding that avoids grass/sand/water where it can), at the car's OWN normal speed.
    -- no flying, no going through walls, no moving the car by script.
    local LEGIT_PFS = game:GetService("PathfindingService")
    -- SAFE FLY speed: the speed YOU really drive this car at (learned while you drive it yourself),
    -- default 60.  Never faster than a normal car.
    do
        local acc, accT = 0, 0
        R.Heartbeat:Connect(function(dt)
            if Travel.driving then acc, accT = 0, 0; return end
            local hum = L.Character and L.Character:FindFirstChildOfClass("Humanoid")
            local car = Travel.myCar and Travel.myCar()
            if not (hum and car and hum.SeatPart and hum.SeatPart:IsDescendantOf(car)) then acc, accT = 0, 0; return end
            local v = hum.SeatPart.AssemblyLinearVelocity
            local sp = Vector3.new(v.X, 0, v.Z).Magnitude
            if sp > 160 then acc, accT = 0, 0; return end                  -- a glitch / fling, not driving
            acc, accT = acc + sp * dt, accT + dt
            if accT >= 1 then
                local avg = acc / accT
                if avg > 20 and avg > (tonumber(S.LearnedCarSpeed) or 0) then S.LearnedCarSpeed = math.floor(avg) end
                acc, accT = 0, 0
            end
        end)
    end
    -- the car's REAL top speed: the game's cars (Roblox car kit) keep it as "forwardMaxSpeed" (mph)
    -- on the car's Engine.  Safe fly drives 10 mph UNDER that.
    local maxCache = setmetatable({}, { __mode = "k" })
    local function mphToStuds(car, mph)
        local v
        pcall(function()
            local units = car:FindFirstChild("Units", true)
            if not (units and units:IsA("ModuleScript")) then
                local name = Travel.spawnedAs and Travel.spawnedAs[car]
                local tpl = name and carsFolder and carsFolder:FindFirstChild(name)
                units = tpl and tpl:FindFirstChild("Units", true)
            end
            if units and units:IsA("ModuleScript") then
                local m = require(units)
                if type(m) == "table" and type(m.milesPerHourToStudsPerSecond) == "function" then
                    v = tonumber(m.milesPerHourToStudsPerSecond(mph))
                end
            end
        end)
        return v or mph * 5280 / 3600          -- the game counts 1 stud = 1 foot
    end
    local function readMaxMph(car)
        local mph
        pcall(function()
            local eng = car:FindFirstChild("Engine", true)
            for _, d in ipairs({ eng, car, driverSeat(car) }) do
                local v = d and tonumber(d:GetAttribute("forwardMaxSpeed"))
                if v and v > 0 then mph = v; return end
            end
            for _, d in ipairs(car:GetDescendants()) do
                local v = tonumber(d:GetAttribute("forwardMaxSpeed"))
                if v and v > 0 then mph = v; return end
            end
        end)
        return mph
    end
    -- returns studs/s for the car you're driving (10 mph under its max) + the mph numbers
    function Travel.safeSpeed(car)
        car = car or (Travel.myCar and Travel.myCar())
        if car then
            local c = maxCache[car]
            if not c or os.clock() - c.t > 10 then                -- re-read (upgrades can change it)
                local mph = readMaxMph(car)
                c = { t = os.clock(), mph = mph, studs = mph and mphToStuds(car, math.max(mph - 10, 5)) }
                maxCache[car] = c
                if mph and Travel.lastMaxMph ~= mph then
                    Travel.lastMaxMph = mph
                    if Travel.trace then pcall(Travel.trace, string.format("car max %.0f mph -> driving %.0f mph (%.1f studs/s)", mph, math.max(mph - 10, 5), c.studs)) end
                end
            end
            if c.studs then return math.clamp(c.studs, 15, 250), c.mph end
        end
        local l = tonumber(S.LearnedCarSpeed)
        return math.clamp(l and l * 0.95 or 60, 30, 150), nil   -- no max found: the speed you drive it at
    end
