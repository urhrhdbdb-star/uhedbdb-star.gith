                        origin = hrp0 and hrp0.Position or origin
                    end
                end
                if not car then
                    -- try one spawn; returns car, or nil + "timer"/"fail"
                    local function trySpawn(name)
                        local t0 = os.clock()
                        local c0 = Travel.myCar()
                        if c0 then return c0 end                          -- it's already out -> just use it
                        local ok, e = spawnCar(name)
                        if not ok then
                            task.wait(0.5)
                            c0 = Travel.myCar()
                            if c0 then return c0 end
                            return nil, "fail", e
                        end
                        local timerSince
                        for _ = 1, 50 do
                            task.wait(0.2)
                            local c = Travel.myCar()
                            if c then Travel.spawnedAs[c] = (Travel.lastSpawnAt > t0 and Travel.lastSpawnName) or name or curCar(); return c end
                            -- "Spawned! available again in 60s" is NOT a timer -> keep waiting for the car to show up
                            if Travel.feedbackAt > t0 and Travel.feedbackOk ~= true
                                and (Travel.timerLeft(name) > 0 or isTimerMsg(string.lower(Travel.feedback))) then
                                timerSince = timerSince or os.clock()
                                if os.clock() - timerSince > 2 then return nil, "timer" end   -- 2s grace: the car can show up late
                            end
                        end
                        if os.clock() - Travel.lastDespawn < 90 then Travel.spawnTimer = true; return nil, "timer" end
                        return nil, "fail"
                    end
                    -- how long we'd wait before gliding is slower anyway
                    local dist = origin and (origin - target).Magnitude or 0
                    local driveT = dist / math.max(S.DriveSpeed or 60, 10)
                    local maxWait = 90   -- always wait for YOUR car (farms always drive)
                    local function waitTimer(name)
                        if Travel.myCar() then return true end           -- car is already out -> no waiting
                        local left = Travel.timerLeft(name)
                        if left <= 0 then return true end
                        if left > maxWait then return false end
                        -- stand still (back in the safe zone if we just left one) - never wander the road
                        waitTimerStill(safeSpot and "waiting in the safe zone" or "standing still until it's ready")
                        return true
                    end
                    local why = "timer"
                    -- 1) your car: spawn now, or wait out the timer if that's faster than gliding
                    if waitTimer() then
                        notifyFn("Travel", "Spawning your carâ¦", "car")
                        car, why = trySpawn()
                        if not car and why == "timer" and waitTimer() then car, why = trySpawn() end
                    end
                    -- inventory not loaded / unknown car -> try each car until one spawns (only yours will)
                    if not car and why ~= "timer" and #Travel.ownedCars() == 0 and S.TravelCar == "" then
                        for _, n in ipairs(Travel.carNames()) do
                            if n ~= curCar() and Travel.timerLeft(n) == 0 then
