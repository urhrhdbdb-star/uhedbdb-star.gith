        end
    end

    -- the grass -> sand wall by the beach (your points): a long straight wall, sand on one side,
    -- grass on top on the other.  Cars cross it on a smooth slope â never into it, never a big drop.
    local CLIFF_A = Vector3.new(-999.95, 0, 456.33)                              -- top edge
    local CLIFF_D = (Vector3.new(-999.34, 0, 534.95) - CLIFF_A).Unit              -- the way the wall runs
    local CLIFF_N = Vector3.new(CLIFF_D.Z, 0, -CLIFF_D.X)
    if CLIFF_N:Dot(Vector3.new(-1008.58, 0, 460.99) - CLIFF_A) > 0 then CLIFF_N = -CLIFF_N end   -- points to the grass side
    local CLIFF_SAND_Y, CLIFF_TOP_Y = 357.74 - 3, 363.86 - 3                      -- ground heights (your body was ~3 up)
    local function cliffS(p) return CLIFF_N:Dot(Vector3.new(p.X, 0, p.Z) - CLIFF_A) end   -- < 0 = sand side
