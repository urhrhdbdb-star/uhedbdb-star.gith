local function rarityOutline(n2)
    local low = string.lower(n2 or "")
    if string.find(low, "mythic") then return Color3.fromRGB(200, 80, 255) end
    if string.find(low, "omega")  then return Color3.fromRGB(255, 60, 60) end
    if string.find(low, "legend") then return Color3.fromRGB(255, 200, 40) end
    if string.find(low, "rare")   then return Color3.fromRGB(80, 140, 255) end
    if string.find(low, "uncommon") or string.find(low, "uncom") then return Color3.fromRGB(80, 220, 80) end
    if string.find(low, "common") then return Color3.fromRGB(190,190,190) end
    if string.find(low, "cash") or string.find(low, "money") or string.find(low, "coin") then return Color3.fromRGB(80, 255, 80) end
    if string.find(low, "energy") or string.find(low, "ammo") or string.find(low, "med") or string.find(low, "shot") then return Color3.fromRGB(80, 180, 255) end
    if string.find(low, "gun") or string.find(low, "pistol") or string.find(low, "rifle") or string.find(low, "smg")
       or string.find(low, "shotgun") or string.find(low, "sniper") or string.find(low, "weapon") or string.find(low, "rpg")
       or string.find(low, "ak") or string.find(low, "m4") or string.find(low, "deagle") or string.find(low, "doublebarrel") then
        return Color3.fromRGB(255, 210, 70)
    end
    return nil
end

local function ensureDrop(part)
    if dropFor[part] and dropFor[part].bill.Parent then return dropFor[part] end
    local bill = Instance.new("BillboardGui")
    bill.AlwaysOnTop = true
    bill.Size = UDim2.new(0, 200, 0, 22)
    bill.StudsOffset = Vector3.new(0, 1.8, 0)
    bill.Adornee = part
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,1,0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.new(1,1,1)
    lbl.TextStrokeColor3 = Color3.new(0,0,0)
    lbl.TextStrokeTransparency = 0
    lbl.Font = Enum.Font.GothamBold
    lbl.TextScaled = true
    lbl.Text = part.Name
    lbl.Parent = bill
    
    bill.Parent = dropGui
    dropFor[part] = {bill = bill, lbl = lbl}
    return dropFor[part]
end

