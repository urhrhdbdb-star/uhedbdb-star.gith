    healthBarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    healthBarBg.BorderSizePixel = 0
    healthBarBg.Parent = mainFrame

    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 90)
    healthBar.BorderSizePixel = 0
    healthBar.Name = "HealthFill"
    healthBar.Parent = healthBarBg

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1, 0, 0, 14)
    infoLabel.Position = UDim2.new(0, 0, 0, 24)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    infoLabel.TextSize = 10
    infoLabel.Font = Enum.Font.Gotham
    infoLabel.Parent = mainFrame

    local weaponLabel = Instance.new("TextLabel")
    weaponLabel.Size = UDim2.new(1, 0, 0, 28)
    weaponLabel.Position = UDim2.new(0, 0, 0, 39)
    weaponLabel.BackgroundTransparency = 1
    weaponLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
    weaponLabel.TextSize = 10
    weaponLabel.Font = Enum.Font.GothamBold
    weaponLabel.TextWrapped = true
    weaponLabel.Parent = mainFrame

    PlayerBillboards[player] = billboard

    local function updateESP()
        local char = player.Character
        local localChar = LP.Character
        if Settings.PlayerESP and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and localChar and localChar:FindFirstChild("HumanoidRootPart") then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            local localRoot = localChar:FindFirstChild("HumanoidRootPart")

            local distance = math.floor((rootPart.Position - localRoot.Position).Magnitude)
            
            local isSafe = char:FindFirstChildOfClass("ForceField") ~= nil or char:GetAttribute("SafeZone") == true or player:GetAttribute("Safe") == true
            local isDowned = char:GetAttribute("Downed") == true or humanoid.Health <= 10
            local isFriend = FriendList[player.Name] == true
            
            if isFriend then
                nameLabel.Text = player.Name .. " [FRIEND]"
                nameLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            elseif isDowned then
                nameLabel.Text = player.Name .. " [DOWNED]"
                nameLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            elseif isSafe then
                nameLabel.Text = player.Name .. " [SAFE]"
                nameLabel.TextColor3 = Color3.fromRGB(0, 170, 255)
            else
                nameLabel.Text = player.Name
                nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            end

            local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            healthBar.Size = UDim2.new(healthPercent, 0, 1, 0)
            
            local currentHealth = math.floor(humanoid.Health)
            local maxHealth = math.floor(humanoid.MaxHealth)
            infoLabel.Text = "[" .. distance .. "M] [" .. currentHealth .. "/" .. maxHealth .. "]"

            local weaponsList = ""
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool.Name:lower() ~= "fists" then
                weaponsList = "[" .. tool.Name .. "]\n"
            end
            local backpack = player:FindFirstChild("Backpack")
            if backpack then
                for _, item in pairs(backpack:GetChildren()) do
                    if item:IsA("Tool") and item.Name:lower() ~= "fists" then
                        weaponsList = weaponsList .. "[" .. item.Name .. "]\n"
                    end
                end
            end
            
            weaponLabel.Text = weaponsList

            billboard.Adornee = rootPart
            billboard.Parent = ESPContainer
            billboard.Enabled = true
        else
            billboard.Enabled = false
        end
    end

    RunService.RenderStepped:Connect(updateESP)
end

