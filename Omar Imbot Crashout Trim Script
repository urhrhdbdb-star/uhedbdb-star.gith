local function alive(c)
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    return h and r and h.Health > 0
end

local function myRoot()
    local c = LP.Character
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end

local function findTarget()
    local root = myRoot()
    if not root then return nil end
    local cx, cy = Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2
    local best, bestD2 = nil, Settings.FOV * Settings.FOV
    for i = 1, #plrs do
        local p = plrs[i]
        if p ~= LP and not FriendList[p.Name] then
            local ch = p.Character
            local isSafe = ch and (ch:FindFirstChildOfClass("ForceField") ~= nil or ch:GetAttribute("SafeZone") == true)
            if alive(ch) and not isSafe then
                local ap = Settings.AimHead and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")) or (ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head"))
                if ap then
                    local sp, onScreen = Camera:WorldToViewportPoint(ap.Position)
                    if onScreen then
                        local dx, dy = sp.X - cx, sp.Y - cy
                        local pd = dx*dx + dy*dy
                        if pd < bestD2 then
                            bestD2 = pd
                            best = ap
                        end
                    end
                end
            end
        end
    end
    return best
end

local hookNames = { raycast = true, findpartonray = true, findpartonraywithwhitelistignorelist = true, findpartonraywithwhitelistandignorelist = true, findpartonraywithwhitelist = true, findpartonraywithignorelist = true }
pcall(function()
    oldNC = hookmetamethod(game, "__namecall", function(self, ...)
        if not Settings.SilentAim or reentry then return oldNC(self, ...) end
        local mm = string.lower(getnamecallmethod())
        if not hookNames[mm] or not (closestPart and closestPart.Parent) then return oldNC(self, ...) end
        reentry = true
        local args = {...}
        local results
        pcall(function()
            local origin = typeof(args[1]) == "Vector3" and args[1] or (typeof(args[1]) == "Ray" and args[1].Origin or Camera.CFrame.Position)
            local targetPos = closestPart.Position
            local direction = (targetPos - origin).Unit * 10000
            
            if mm == "raycast" then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Include
                rp.FilterDescendantsInstances = { closestPart.Parent }
                local r = Workspace:Raycast(origin, direction, rp)
                if r then results = { r } else results = { oldNC(self, unpack(args)) } end
            else
                local ray = Ray.new(origin, direction)
                local h, p2, n2, m2 = Workspace:FindPartOnRayWithWhitelist(ray, { closestPart.Parent })
                if h then results = { h, p2, n2, m2 } else results = { oldNC(self, unpack(args)) } end
            end
        end)
        reentry = false
        if not results then return oldNC(self, ...) end
        return unpack(results)
    end)
end)

RunService.Heartbeat:Connect(function()
    closestPart = Settings.SilentAim and findTarget() or nil
end)

RunService.Stepped:Connect(function()
    pcall(function()
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum then
                if Settings.SpeedEnabled then hum.WalkSpeed = Settings.WalkSpeedValue end
                if Settings.JumpEnabled then hum.UseJumpPower = true; hum.JumpPower = Settings.JumpPowerValue end
            end
            if Settings.NoclipEnabled and root then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if root.Position.Y > 2 then part.CanCollide = false else part.CanCollide = true end
                    end
                end
            end
        end
    end)
end)

RunService.Heartbeat:Connect(function()
    pcall(function()
        local myR = myRoot()
        for part, d in pairs(dropFor) do
            if not (part and part.Parent) then
                pcall(function() d.bill:Destroy() end)
                dropFor[part] = nil
            else
                if not Settings.DropESP then
                    d.bill.Enabled = false
                else
                    local far = myR and (part.Position - myR.Position).Magnitude > 60
                    if far then
                        d.bill.Enabled = false
                    else
                        local col = rarityOutline(part.Name)
                        if col then
                            d.lbl.TextStrokeColor3 = col
                            d.bill.Enabled = true
                        else
                            d.bill.Enabled = false
                        end
                    end
                end
            end
        end
    end)
end)

